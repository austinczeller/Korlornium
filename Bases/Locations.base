filters:
  and:
    - Type == "Location"
views:
  - type: table
    name: All
    order:
      - file.name
      - Location
      - Location_Category
      - Place_Description
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      note.Location: 205
      note.Location_Category: 123
  - type: table
    name: Settlements
    filters:
      and:
        - Location_Category.containsAny("City", "Town", "Village", "Port")
    order:
      - file.name
      - Location
      - Location_Category
      - Place_Description
  - type: table
    name: Venues
    filters:
      and:
        - Location_Category.containsAny("Tavern", "Shop", "Temple", "Government", "House", "Ruin", "Dungeon")
    order:
      - file.name
      - Location
      - Location_Category
      - Place_Description
  - type: table
    name: Geographic
    filters:
      and:
        - Location_Category.containsAny("Planet", "Continent", "Region", "Waterbody", "Island", "Nature")
    order:
      - file.name
      - Location_Category
      - Place_Description
  - type: table
    name: Stormveil
    filters:
      or:
        - Location.contains(link("Stormveil"))
        - file.name == "Stormveil"
    order:
      - file.name
      - Location_Category
      - Place_Description
    sort:
      - property: Location_Category
        direction: ASC
    columnSize:
      note.Location: 165
      note.Location_Category: 111
  - type: table
    name: Heaven's Hole
    filters:
      or:
        - file.name == "Heaven's Hole"
        - Location.contains(link("Heaven's Hole"))
    order:
      - file.name
      - Location_Category
      - Place_Description
    sort:
      - property: Location_Category
        direction: ASC
    columnSize:
      note.Location_Category: 124
  - type: table
    name: Duskwind Landing
    filters:
      or:
        - file.name == "Duskwind Landing"
        - Location.contains(link("Duskwind Landing"))
    order:
      - file.name
      - Location_Category
      - Place_Description
    sort:
      - property: Location_Category
        direction: ASC
    columnSize:
      note.Location_Category: 111
  - type: table
    name: Dithoria City
    filters:
      or:
        - file.name == "Dithoria City"
        - Location.contains(link("Dithoria City"))
    order:
      - file.name
      - Location_Category
      - Place_Description
    sort:
      - property: Location_Category
        direction: ASC
    columnSize:
      note.Location_Category: 111
  - type: table
    name: Thalmyre
    order:
      - file.name
      - Location_Category
      - Place_Description
      - Location
